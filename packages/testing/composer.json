{
    "name": "marko/testing",
    "description": "Testing utilities for the Marko framework - fakes, assertions, and Pest integration",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/cache": "self.version",
        "marko/clock": "self.version",
        "marko/broadcasting": "self.version",
        "marko/config": "self.version",
        "marko/encryption": "self.version",
        "marko/filesystem": "self.version",
        "marko/mail": "self.version",
        "marko/notification": "self.version",
        "marko/queue": "self.version",
        "marko/session": "self.version",
        "marko/log": "self.version",
        "marko/authentication": "self.version",
        "marko/http": "self.version",
        "marko/routing": "self.version",
        "marko/validation": "self.version",
        "psr/clock": "^1.0",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "marko/cache-array": "self.version",
        "marko/database": "self.version",
        "marko/filesystem-local": "self.version",
        "marko/forms": "self.version",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "marko/database": "Required for TestDatabase, RefreshDatabase and TruncateDatabase (install a driver such as marko/database-pgsql)",
        "marko/forms": "Required for the flashed form state assertions (assertSessionHasErrors, assertSessionHasInput, ...)",
        "pestphp/pest": "Required for the Pest expectations (toHavePushed, toHaveSent, ...); the fakes and their assert*() methods work without it"
    },
    "conflict": {
        "pestphp/pest": "<4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Testing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        },
        "pest": {
            "plugins": [
                "Marko\\Testing\\Pest\\ExpectationsPlugin",
                "Marko\\Testing\\Pest\\ShutdownApplicationsPlugin"
            ]
        }
    }
}
