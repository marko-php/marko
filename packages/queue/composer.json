{
    "name": "marko/queue",
    "description": "Queue interfaces and infrastructure for Marko Framework",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "marko/cache": "self.version",
        "marko/clock": "self.version",
        "marko/core": "self.version",
        "marko/encryption": "self.version"
    },
    "suggest": {
        "ext-pcntl": "Required for queue:work job timeouts and graceful SIGTERM/SIGINT shutdown"
    },
    "require-dev": {
        "marko/cache-array": "self.version",
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Queue\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
