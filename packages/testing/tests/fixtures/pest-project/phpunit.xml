<?xml version="1.0" encoding="UTF-8"?>
<!--
    Fixture Pest project for PestPluginRegistrationTest. It is run in a
    subprocess against the monorepo's own Composer install, where marko/testing
    is a real (path) dependency in vendor/ and vendor/pest-plugins.json is
    generated by pestphp/pest-plugin exactly as in a user project. Spec files
    use the Spec.php suffix so the monorepo suite (*Test.php) never collects them.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../../../../vendor/phpunit/phpunit/phpunit.xsd"
         colors="false"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="Fixture">
            <directory suffix="Spec.php">tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
