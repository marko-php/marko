{
    "name": "marko/authentication-two-factor",
    "description": "Two-factor authentication (TOTP and recovery codes) for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/authentication": "self.version",
        "marko/clock": "self.version",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/ratelimiter": "self.version",
        "marko/routing": "self.version",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "marko/cache-array": "self.version",
        "marko/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Marko\\AuthenticationTwoFactor\\": "src/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
