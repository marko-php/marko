{
    "name": "marko/scheduler",
    "description": "Task scheduling for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/cli": "self.version",
        "marko/clock": "self.version"
    },
    "require-dev": {
        "marko/cache": "self.version",
        "marko/cache-redis": "self.version",
        "marko/redis": "self.version",
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "marko/cache": "Atomic locks for onOneServer() and LockTaskMutex; pair it with marko/cache-redis so the lock is shared by every server"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Scheduler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Scheduler\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
