{
    "name": "marko/authentication-database",
    "description": "Database-backed password reset token storage for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/authentication": "self.version",
        "marko/database": "self.version"
    },
    "require-dev": {
        "marko/cache-array": "self.version",
        "marko/database-mysql": "self.version",
        "marko/database-pgsql": "self.version",
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Authentication\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Authentication\\Database\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
