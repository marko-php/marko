{
    "name": "marko/authentication-passkey",
    "description": "Passkey (WebAuthn) sign-in and passkey management for Marko Framework",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "lbuchs/webauthn": "^2.2",
        "marko/authentication": "self.version",
        "marko/clock": "self.version",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "marko/ratelimiter": "self.version",
        "marko/routing": "self.version",
        "marko/session": "self.version"
    },
    "require-dev": {
        "marko/cache-array": "self.version",
        "marko/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Marko\\AuthenticationPasskey\\": "src/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
