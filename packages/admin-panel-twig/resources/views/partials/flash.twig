{% set flashMessages = flashMessages|default([]) %}

{% if flashMessages %}<div class="flash-messages">
    {% if flashMessages.success is defined %}<div class="flash-message flash-success" role="alert">
        {{ flashMessages.success }}
    </div>{% endif %}

    {% if flashMessages.error is defined %}<div class="flash-message flash-error" role="alert">
        {{ flashMessages.error }}
    </div>{% endif %}
</div>{% endif %}
