{
    "name": "marko/forms",
    "description": "Server-rendered form round trips for Marko Framework - redirect back with flashed validation errors and old input, plus csrf_field/old/errors template helpers",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/routing": "self.version",
        "marko/security": "self.version",
        "marko/session": "self.version",
        "marko/validation": "self.version",
        "marko/view": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "marko/view-latte": "self.version",
        "marko/view-twig": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Forms\\": "src/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
