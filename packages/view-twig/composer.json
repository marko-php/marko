{
    "name": "marko/view-twig",
    "description": "Twig templating driver for Marko Framework View",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "marko/view": "self.version",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\View\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\View\\Twig\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
