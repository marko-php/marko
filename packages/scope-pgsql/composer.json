{
    "name": "marko/scope-pgsql",
    "description": "PostgreSQL driver for Marko Framework Scope Module",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/scope": "self.version",
        "marko/database-pgsql": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Marko\\Scope\\PgSql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marko\\Scope\\PgSql\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
